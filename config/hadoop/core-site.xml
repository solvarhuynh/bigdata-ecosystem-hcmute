<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
    <!-- Master NameNode URL -->
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://nghia-master:9000</value>
    </property>

    <!-- Thư mục lưu dữ liệu tạm của Hadoop -->
    <property>
        <name>hadoop.tmp.dir</name>
        <value>/opt/hadoop/tmp</value>
    </property>

    <!-- Proxyuser cấu hình cho user hadoopnghia để Hive và Spark không bị lỗi phân quyền -->
    <property>
        <name>hadoop.proxyuser.hadoopnghia.hosts</name>
        <value>*</value>
    </property>
    <property>
        <name>hadoop.proxyuser.hadoopnghia.groups</name>
        <value>*</value>
    </property>
    <property>
        <name>hadoop.proxyuser.hadoopnghia.users</name>
        <value>*</value>
    </property>

    <!-- Proxyuser cấu hình cho root -->
    <property>
        <name>hadoop.proxyuser.root.hosts</name>
        <value>*</value>
    </property>
    <property>
        <name>hadoop.proxyuser.root.groups</name>
        <value>*</value>
    </property>
    <property>
        <name>hadoop.proxyuser.root.users</name>
        <value>*</value>
    </property>
</configuration>