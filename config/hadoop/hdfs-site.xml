<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
    <!-- Số lượng bản sao lưu (4 workers -> replication factor 3 hoặc 4) -->
    <property>
        <name>dfs.replication</name>
        <value>3</value>
    </property>

    <!-- Thư mục lưu NameNode metadata và DataNode blocks -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>/opt/hadoop/hdfs/namenode</value>
    </property>
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>/opt/hadoop/hdfs/datanode</value>
    </property>

    <!-- Địa chỉ lắng nghe Web UI của NameNode -->
    <property>
        <name>dfs.namenode.http-address</name>
        <value>0.0.0.0:9870</value>
    </property>

    <!-- Tắt kiểm tra phân quyền nếu chạy môi trường test học tập -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
    </property>

    <property>
        <name>dfs.namenode.rpc-bind-host</name>
        <value>0.0.0.0</value>
    </property>
</configuration>