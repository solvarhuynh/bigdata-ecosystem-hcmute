# BẮT BUỘC: thay toàn bộ giá trị IP bằng IP thật của môi trường LAN/Tailscale.
MASTER_IP=
WORKER1_IP=
WORKER2_IP=
WORKER3_IP=
WORKER4_IP=

# Vai trò của máy hiện tại: master hoặc worker. Compose sẽ đặt giá trị này theo service.
NODE_ROLE=

# Tên hostname thực tế của node hiện tại, tự chọn, không phải bí danh Hadoop.
# Ví dụ (chỉ để tham khảo): An-worker hoặc Binh-slave.
NODE_HOSTNAME=

# Bí danh logic và IP của node hiện tại khi dùng docker-compose.worker.yml.
WORKER_LOGICAL_NAME=
WORKER_IP=

# Hostname thực tế của từng worker, dùng để thêm alias trên mọi node.
WORKER1_HOSTNAME=
WORKER2_HOSTNAME=
WORKER3_HOSTNAME=
WORKER4_HOSTNAME=
MASTER_HOSTNAME=nghia-master

# Tên Docker Image chuẩn
IMAGE_NAME=bigdata-cluster:1.0
