# Bắt buộc cho triển khai đầy đủ: thay mọi IP bằng địa chỉ IPv4 thật, truy cập được.
MASTER_IP=
WORKER1_IP=
WORKER2_IP=
WORKER3_IP=
WORKER4_IP=

# Chỉ dùng bởi Compose Worker; hostname thực tế do người triển khai tự chọn.
# Các hostname và IP bên dưới phải mô tả cùng một mapping trên tất cả node.
NODE_HOSTNAME=
# Bí danh logic được Master phân công, chỉ nhận worker1, worker2, worker3 hoặc worker4.
WORKER_LOGICAL_NAME=
# IP của Worker hiện tại; phải bằng WORKERn_IP của logical name được phân công.
WORKER_IP=

# Hostname thực tế của từng worker, dùng để thêm alias trên mọi node.
WORKER1_HOSTNAME=
WORKER2_HOSTNAME=
WORKER3_HOSTNAME=
WORKER4_HOSTNAME=
MASTER_HOSTNAME=nghia-master

# Tên Docker Image chuẩn
IMAGE_NAME=bigdata-cluster:1.0
